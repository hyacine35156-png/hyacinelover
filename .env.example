# Hyacine 小助手环境变量配置
# 复制此文件为 .env 并填入实际值

# JWT 签名密钥（必填，生产环境必须使用强随机字符串）
# 生成方式：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-strong-random-secret-here

# 数据库连接（如适用）
# DATABASE_URL=postgresql://user:password@localhost:5432/hyacine

# 服务端口
# PORT=3000

# Node 环境
# NODE_ENV=production
