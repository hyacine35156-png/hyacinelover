# Dependencies
node_modules/
*/node_modules/

# Production builds
dist/
*/dist/
build/
*/build/

# Environment files
.env
.env.local

# 禁止提交源码归档/压缩包
*.zip
*.tar.gz
*.rar

# 禁止再次提交 client/ 下的源码副本（只允许 index.html 与 public/）
client/api/
client/components/
client/contexts/
client/hooks/
client/lib/
client/pages/
client/types/
client/utils/
client/*.tsx
client/*.css

# 禁止提交数据库导出文件
banks.json
question.json
question_bank.json
question_bank_version.json
question_tag.json
subject.json
*.db
*.sqlite
*.sqlite3

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
/logs/

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/
*.lcov

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Temporary folders
tmp/
temp/
.playwright-cli/

# Lock files (keep package-lock.json for consistent installs)
yarn.lock
pnpm-lock.yaml

# Cache files
.eslintcache
*.tsbuildinfo

# swc wasm
.swc

# Agent files
.agent/
.npm_cache

# 测试输出临时文件
test_output.txt
